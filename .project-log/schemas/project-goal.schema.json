{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.local/schemas/project-goal.schema.json",
  "type": "object",
  "required": ["schema_version", "goal"],
  "properties": {
    "schema_version": {"const": 1},
    "goal": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "id",
            "statement",
            "success_conditions",
            "non_goals",
            "constraints",
            "required_evidence",
            "risk_level",
            "status"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^GOAL-[0-9]{3,}$"},
            "statement": {"type": "string", "minLength": 1},
            "success_conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "statement", "status", "evidence_refs"],
                "properties": {
                  "id": {"type": "string", "pattern": "^SC-[0-9]{3,}$"},
                  "statement": {"type": "string", "minLength": 1},
                  "status": {"enum": ["pending", "passed", "failed", "not-applicable"]},
                  "evidence_refs": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              }
            },
            "non_goals": {"type": "array", "items": {"type": "string"}},
            "constraints": {"type": "array", "items": {"type": "string"}},
            "required_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "subject", "evidence_refs"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "subject": {"type": "string", "minLength": 1},
                  "evidence_refs": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              }
            },
            "risk_level": {"enum": ["low", "normal", "high", "critical"]},
            "status": {"enum": ["draft", "active", "waiting-user", "blocked", "complete"]},
            "created_at": {"type": ["string", "null"]},
            "updated_at": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
