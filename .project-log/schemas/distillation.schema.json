{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "candidates"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "stage",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "observation",
              "candidate",
              "repeated-evidence",
              "approved-rule",
              "encoded-asset",
              "evaluated",
              "rejected"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "context": {
            "type": "array"
          },
          "evidence": {
            "type": "array"
          },
          "counterexamples": {
            "type": "array"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
