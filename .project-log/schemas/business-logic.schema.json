{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.local/schemas/business-logic.schema.json",
  "title": "Atomic Business Logic Register",
  "type": "object",
  "required": [
    "version",
    "source_of_truth",
    "atoms"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "boolean"
    },
    "atoms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atom"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "atom": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "domain",
        "status",
        "authority",
        "description",
        "trigger",
        "rule",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BL-[A-Z0-9]+-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "flow",
            "rule",
            "state-transition",
            "constraint",
            "data-contract",
            "integration"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "experimental",
            "deprecated",
            "archived",
            "conflict"
          ]
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "authority": {
          "enum": [
            "user-confirmed",
            "inferred",
            "evidence-derived",
            "experimental"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "user-statement",
                "document",
                "code",
                "test",
                "config",
                "decision",
                "external-evidence",
                "agent-inference"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "type": "object",
          "required": [
            "statement"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_handling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "given",
              "when",
              "then"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "not-verified",
                  "partial",
                  "passed",
                  "failed",
                  "not-applicable"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
